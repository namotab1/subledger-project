              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Service reports ok\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
                ]
              }
