                "exec": [
                  "// A fresh email on every run, so the collection can be re-run against the same database.",
                  "const email = \"asha.\" + Date.now() + \"@example.com\";",
                  "pm.collectionVariables.set(\"customer_email\", email);",
                  "pm.collectionVariables.set(\"customer_email_upper\", email.toUpperCase());"
