              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Issued, unpaid, priced from the plan\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(\"issued\");",
                  "    pm.expect(body.amount_due).to.eql(\"49.99\");",
                  "    pm.expect(body.amount_paid).to.eql(\"0.00\");",
                  "    pm.expect(body.amount_remaining).to.eql(\"49.99\");",
                  "    pm.expect(body.due_date).to.eql(\"2026-02-14\");  // period start + 14 days",
                  "});",
                  "pm.collectionVariables.set(\"invoice_id\", pm.response.json().id);"
                ]
