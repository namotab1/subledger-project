                  "pm.test(\"Five entries, in the order things happened\", function () {",
                  "    const entries = pm.response.json();",
                  "    pm.expect(entries.map(function (e) { return e.entry_type; })).to.eql([",
                  "        \"invoice_created\", \"invoice_created\", \"payment_success\", \"payment_failure\", \"payment_success\"",
                  "    ]);",
                  "});",
                  "pm.test(\"Payment entries are traceable to their payment attempt through reference_id\", function () {",
                  "    const entries = pm.response.json();",
                  "    pm.expect(entries[2].reference_id).to.eql(\"payment_attempt:\" + pm.collectionVariables.get(\"partial_attempt_id\"));",
                  "    pm.expect(entries[3].reference_id).to.eql(\"payment_attempt:\" + pm.collectionVariables.get(\"failed_attempt_id\"));",
                  "    pm.expect(entries[4].reference_id).to.eql(\"payment_attempt:\" + pm.collectionVariables.get(\"final_attempt_id\"));",
                  "});",
                  "pm.test(\"The invoice_created entry points at the first invoice\", function () {",
                  "    pm.expect(pm.response.json()[0].reference_id).to.eql(\"invoice:\" + pm.collectionVariables.get(\"invoice_id\"));",
                  "});"
                ]
